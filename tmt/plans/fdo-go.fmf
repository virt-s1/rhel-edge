summary: FDO go-fdo-client tests against a RHEL 10.x nightly compose
description: |
    Runs the go-fdo-ci package-mode client tests against the go-fdo-client
    package taken from the RHEL 10.x nightly compose under test. go-fdo-server*
    is installed from the same nightly compose as a runtime dependency.

    Test scripts are discovered from go-fdo-ci at a pinned commit so they are
    not duplicated here; package-mode tests install straight from the
    provisioned nightly repos. The bootc client test (tag:bootc) is
    deliberately EXCLUDED for now: it needs the additive upstream change
    (install go-fdo-client from the nightly compose instead of Copr). Once that lands,
    widen the filter to "tag:client" to pick bootc up too. Note that the bootc test
    also needs DOWNLOAD_NODE in the test environment, which this CI deliberately
    does not pass while plans run from a pull request's own ref.

discover:
  how: fmf
  url: https://github.com/fido-device-onboard/go-fdo-ci
  # Pinned so a compose result reflects one known set of test scripts.
  # Bump deliberately after reviewing the upstream changes.
  ref: 189c3255c4ede4de36a258cb1fe5b7e47b4d984c
  path: /test/fmf/tests
  filter: "tag:client & tag:e2e"

provision:
  hardware:
    virtualization:
      is-supported: true
    cpu:
      processors: ">= 2"
    memory: ">= 6 GB"
    disk:
      - size: ">= 30 GB"

prepare:
  - how: shell
    name: Install go-fdo-client and go-fdo-server from the nightly compose
    script: |
      set -euxo pipefail
      dnf config-manager --set-disabled \
        testing-farm-tag-repository \
        testing-farm-tag-repository-mainline \
        testing-farm-tag-repository-z-stream \
        || true
      dnf install -y --disablerepo='testing-farm-tag-repository*' \
        go-fdo-client \
        go-fdo-server \
        go-fdo-server-manufacturer \
        go-fdo-server-owner \
        go-fdo-server-rendezvous
      rpm -q go-fdo-client go-fdo-server go-fdo-server-manufacturer go-fdo-server-owner go-fdo-server-rendezvous

  - how: install
    package:
      - golang
      - make
      - openssl
      - curl
      - git
      - jq
      - npm
      - sqlite
      - podman
      - skopeo
      - wget
      - xorriso
      - expect
      - createrepo_c
      - qemu-img
      - qemu-kvm
      - libvirt-client
      - libvirt-daemon-kvm
      - virt-install
      - firewalld
      - lorax
      - gobject-introspection
      - rpm-build
      - go-rpm-macros

execute:
  how: tmt

/x86:
  summary: go-fdo-client tests on x86_64
  adjust+:
    - when: arch != x86_64
      enabled: false

/arm:
  summary: go-fdo-client tests on aarch64
  adjust+:
    - when: arch != aarch64
      enabled: false
