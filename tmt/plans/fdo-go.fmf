summary: FDO go-fdo-client and go-fdo-server tests against a RHEL 10.x nightly compose
description: |
    Runs the go-fdo-ci package-mode onboarding tests against the go-fdo-client
    and go-fdo-server packages (manufacturer, rendezvous, owner) taken from the
    RHEL 10.x nightly compose under test. Both components are installed from
    the provisioned nightly repos: the prepare step installs them with the
    Testing Farm tag repositories disabled, and INSTALLATION_SOURCE=distro
    keeps the upstream helpers reinstalling from those same repos after each
    test's cleanup.

    Test scripts are discovered from go-fdo-ci at a pinned commit so they are
    not duplicated here. Both the package-mode tests (tag:rpm) and the bootc
    test (tag:bootc) are selected. Until the additive upstream change lands,
    the bootc test installs go-fdo-client from Copr rather than from the
    nightly compose. The bootc test also needs DOWNLOAD_NODE in the test
    environment, which this CI deliberately does not pass while plans run
    from a pull request's own ref. Bootc tests are currently not enabled, but
    will be when the filter is changed to "tag:rpm | tag:bootc".

discover:
  how: fmf
  url: https://github.com/fido-device-onboard/go-fdo-ci
  # Pinned so a compose result reflects one known set of test scripts.
  # Bump deliberately after reviewing the upstream changes.
  # Last updated: 2026-10-15 (upstream commit from 2026-10-14)
  ref: d1a72e150ac84b3bc3d16db9b8547d89606db4c7
  filter: "tag:rpm"

environment:
  INSTALLATION_SOURCE: distro

provision:
  hardware:
    virtualization:
      is-supported: true
    cpu:
      processors: ">= 2"
    memory: ">= 6 GB"
    disk:
      - size: ">= 30 GB"

prepare:
  - how: shell
    name: Install go-fdo-client and go-fdo-server from the nightly compose
    script: |
      set -euxo pipefail
      rpm -q --whatprovides 'dnf-command(config-manager)' &>/dev/null \
        || dnf install -y 'dnf-command(config-manager)'
      dnf config-manager --set-disabled \
        testing-farm-tag-repository-mainline \
        testing-farm-tag-repository-z-stream
      dnf install -y --disablerepo='testing-farm-tag-repository*' \
        go-fdo-client \
        go-fdo-server \
        go-fdo-server-manufacturer \
        go-fdo-server-owner \
        go-fdo-server-rendezvous
      rpm -q go-fdo-client go-fdo-server go-fdo-server-manufacturer go-fdo-server-owner go-fdo-server-rendezvous

  - how: install
    package:
      - golang
      - make
      - openssl
      - curl
      - git
      - jq
      - npm
      - sqlite
      - podman
      - skopeo
      - wget
      - xorriso
      - expect
      - createrepo_c
      - qemu-img
      - qemu-kvm
      - libvirt-client
      - libvirt-daemon-kvm
      - virt-install
      - firewalld
      - lorax
      - gobject-introspection
      - rpm-build
      - go-rpm-macros

execute:
  how: tmt

/x86:
  summary: go-fdo-client and go-fdo-server tests on x86_64
  adjust+:
    - when: arch != x86_64
      enabled: false

/arm:
  summary: go-fdo-client and go-fdo-server tests on aarch64
  adjust+:
    - when: arch != aarch64
      enabled: false
