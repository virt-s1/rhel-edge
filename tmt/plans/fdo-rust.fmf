summary: FDO fdo-client tests against a RHEL 9.x nightly compose
description: |
    Runs the fido-device-onboard-rs client tests against the fdo-client package
    taken from the RHEL 9.x nightly compose under test.

    Tests 3 ownership voucher storage backends: Directory, PostgreSQL, and SQLite.

    Test scripts are downloaded from fido-device-onboard-rs at a pinned commit
    and patched to use dynamically allocated ports (starting at 8080) to avoid
    port conflicts.

    The fdo-client package is installed straight from the provisioned nightly
    repos. postgresql-server, sqlite and the SELinux rules replicate the upstream
    onboarding plan's prepare, which assumes the package is already installed.

discover:
  how: shell
  tests:
    - name: fdo-onboarding-directory
      test: OV_STORE_DRIVER=Directory /usr/local/bin/fdo-test-wrapper.sh
      duration: 30m
    - name: fdo-onboarding-postgres
      test: OV_STORE_DRIVER=Postgres /usr/local/bin/fdo-test-wrapper.sh
      duration: 30m
    - name: fdo-onboarding-sqlite
      test: OV_STORE_DRIVER=Sqlite /usr/local/bin/fdo-test-wrapper.sh
      duration: 30m

provision:
  hardware:
    virtualization:
      is-supported: true
    cpu:
      processors: ">= 2"
    memory: ">= 4 GB"
    disk:
      - size: ">= 30 GB"

prepare:
  - how: shell
    name: Create FDO test wrapper with dynamic port allocation
    script: |
      set -euxo pipefail
      cat > /usr/local/bin/fdo-test-wrapper.sh <<'EOF'
      #!/bin/bash
      set -euxo pipefail

      PORT_BASE=8080
      PORTS_NEEDED=4
      # Limit search to IANA registered range to avoid ephemeral port conflicts
      MAX_PORT=$((49152 - PORTS_NEEDED))

      found_block=false
      while [ $PORT_BASE -le $MAX_PORT ]; do
        block_is_free=true
        for offset in 0 1 2 3; do
          current_port=$((PORT_BASE + offset))
          if ss -tlnH sport = :$current_port | grep -q .; then
            block_is_free=false
            PORT_BASE=$((current_port + 1))
            break
          fi
        done
        if [ "$block_is_free" = true ]; then
          found_block=true
          break
        fi
      done

      if [ "$found_block" = false ]; then
        echo "Error: Unable to find $PORTS_NEEDED consecutive free ports below $MAX_PORT" >&2
        exit 1
      fi

      echo "Using ports: $PORT_BASE - $((PORT_BASE + PORTS_NEEDED - 1))"

      P0=$PORT_BASE
      P1=$((PORT_BASE+1))
      P2=$((PORT_BASE+2))
      P3=$((PORT_BASE+3))

      # Pinned to upstream commit 99e4b691 (2026-08-09)
      # Bump deliberately after reviewing upstream changes
      # Port replacement uses negative lookahead/lookbehind to avoid matching within larger numbers
      curl -fsSL https://raw.githubusercontent.com/fdo-rs/fido-device-onboard-rs/99e4b691a4f9ebeb53a049c817ce4e6d9e73b46a/test/fmf/tests/onboarding/run-onboarding.sh \
        | sed -E -e "s/(^|[^0-9])8080([^0-9]|$)/\1__PORT0__\2/g" \
                 -e "s/(^|[^0-9])8081([^0-9]|$)/\1__PORT1__\2/g" \
                 -e "s/(^|[^0-9])8082([^0-9]|$)/\1__PORT2__\2/g" \
                 -e "s/(^|[^0-9])8083([^0-9]|$)/\1__PORT3__\2/g" \
                 -e "s/808\{0\.\.3\}/__PORT0__ __PORT1__ __PORT2__ __PORT3__/g" \
                 -e "s/__PORT0__/$P0/g" \
                 -e "s/__PORT1__/$P1/g" \
                 -e "s/__PORT2__/$P2/g" \
                 -e "s/__PORT3__/$P3/g" > /tmp/run-onboarding.sh

      chmod +x /tmp/run-onboarding.sh
      exec /tmp/run-onboarding.sh
      EOF
      chmod +x /usr/local/bin/fdo-test-wrapper.sh

  - how: shell
    name: Install fdo packages from the nightly compose
    script: |
      set -euxo pipefail
      rpm -q --whatprovides 'dnf-command(config-manager)' &>/dev/null \
        || dnf install -y 'dnf-command(config-manager)'
      dnf config-manager --set-disabled \
        testing-farm-tag-repository-mainline \
        testing-farm-tag-repository-z-stream
      dnf install -y --disablerepo='testing-farm-tag-repository*' \
        fdo-admin-cli \
        fdo-client \
        fdo-init \
        fdo-manufacturing-server \
        fdo-owner-cli \
        fdo-owner-onboarding-server \
        fdo-rendezvous-server
      dnf install -y postgresql-server sqlite
      rpm -q fdo-admin-cli fdo-client fdo-manufacturing-server fdo-owner-cli fdo-owner-onboarding-server fdo-rendezvous-server

  - how: shell
    name: Add SELinux permissions for FDO onboarding tests
    script: |
      set -euxo pipefail
      cat > /tmp/fdo-selinux.cil <<'EOF'
      (allow fdo_t etc_t (file (write)))
      (allow fdo_t fdo_conf_t (file (append create rename setattr unlink write)))
      (allow fdo_t fdo_var_lib_t (dir (add_name remove_name write)))
      (allow fdo_t fdo_var_lib_t (file (create setattr unlink write)))
      (allow fdo_t krb5_keytab_t (dir (search)))
      (allow fdo_t postgresql_port_t (tcp_socket (name_connect)))
      (allow fdo_t sssd_t (unix_stream_socket (connectto)))
      (allow fdo_t sssd_var_run_t (sock_file (write)))
      (allow fdo_t port_type (tcp_socket (name_bind name_connect)))
      EOF
      semodule -i /tmp/fdo-selinux.cil

execute:
  how: tmt

/x86:
  summary: fido-device-onboard tests on x86_64
  adjust+:
    - when: arch != x86_64
      enabled: false

/arm:
  summary: fido-device-onboard tests on aarch64
  adjust+:
    - when: arch != aarch64
      enabled: false
